# ============================================
# MoodEnhancer Backend - Environment Variables
# ============================================

# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:8080

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/moodenhancer?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_also_change_this
JWT_REFRESH_EXPIRE=30d

# OpenAI
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# Spotify API (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# TMDB Movie API (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your_tmdb_api_key
TMDB_BASE_URL=https://api.themoviedb.org/3

# YouTube Data API v3 (https://console.cloud.google.com)
YOUTUBE_API_KEY=your_youtube_api_key

# Email (Nodemailer - use Gmail App Password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=MoodEnhancer <noreply@moodenhancer.app>

# Crisis Helpline Numbers (Indian context)
CRISIS_HELPLINE_IN=iCall: 9152987821
CRISIS_HELPLINE_VANDREVALA=Vandrevala Foundation: 1860-2662-345

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Bcrypt
BCRYPT_ROUNDS=12
