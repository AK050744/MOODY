# ============================================
# MoodEnhancer Backend - Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MySQL Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=MOODY
DB_USER=root
DB_PASS=your_mysql_password

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_also_change_this
JWT_REFRESH_EXPIRE=30d

# Google Gemini AI (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# Spotify API (https://developer.spotify.com/dashboard) — optional
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# TMDB Movie API (https://www.themoviedb.org/settings/api) — optional
TMDB_API_KEY=your_tmdb_api_key
TMDB_BASE_URL=https://api.themoviedb.org/3

# YouTube Data API v3 (https://console.cloud.google.com) — optional
YOUTUBE_API_KEY=your_youtube_api_key

# Bcrypt
BCRYPT_ROUNDS=12
